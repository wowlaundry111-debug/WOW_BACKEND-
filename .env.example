# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?appName=<AppName>

# JWT signing secret — generate a strong random string (e.g. openssl rand -hex 64)
JWT_SECRET=replace-with-a-long-random-string-at-least-64-chars

# Email — Resend (used on Render / production)
# Resend uses HTTPS (port 443) so it works on ALL hosting platforms.
# Render blocks outbound SMTP ports (25, 465, 587) which is why Gmail fails.
#
# 1. Sign up free at https://resend.com
# 2. Add and verify your sending domain  (or test with onboarding@resend.dev)
# 3. Create an API Key and paste it below
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=WOW Laundry <noreply@yourdomain.com>

# Email — SMTP fallback (local dev only, NOT for Render)
# Only used if RESEND_API_KEY is not set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Cloudinary (image uploads)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Render deployment — set this on the Render dashboard, not locally
# RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Server port (optional, defaults to 3000)
# PORT=3000
