# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?appName=<AppName>

# JWT signing secret — generate a strong random string (e.g. openssl rand -hex 64)
JWT_SECRET=replace-with-a-long-random-string-at-least-64-chars

# SMTP (email for OTP delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=WOW Laundry
SMTP_FROM_EMAIL=your-email@gmail.com

# Cloudinary (image uploads)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Render deployment — set this on the Render dashboard, not locally
# RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Server port (optional, defaults to 3000)
# PORT=3000
